  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "@x-titan/pipeline": "^0.5.0",
    "dotenv": "^17",
    "dotenv-cli": "^11",
    "http-errors": "^2.0.1",
    "pino": "^10",
    "pino-pretty": "^13",
    "royale-api-types": "^1.1.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/node": "^26.6.6",
    "nodemon": "^3",
    "prettier": "^3",
    "ts-add-js-extension": "^1",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4"
  }
