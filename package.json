{
  "name": "cr-data-exporter",
  "version": "0.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "start": "node dist",
    "build": "tsc && tsup && ts-add-js-extension --dir=dist",
    "dev": "nodemon",
    "test": "vitest run",
    "start:tsx": "tsx src",
    "build:tsup": "tsup",
    "build:tsup-esm": "tsup src/index.ts --format esm",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "cargo-watch": "cargo watch -x run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
